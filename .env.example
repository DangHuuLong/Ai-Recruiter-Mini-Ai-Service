APP_NAME=ai-recruiter-mini-ai-service
APP_ENV=development
APP_VERSION=0.1.0
APP_PORT=8000

LOG_LEVEL=INFO

AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

REQUEST_TIMEOUT_SECONDS=30

# CV-JD similarity scorer (blended into /score/application) — off by default
# (SIMILARITY_SCORING_WEIGHT=0.0). See docs/model-integration-guide.md.
SIMILARITY_MODEL_PATH=
SIMILARITY_BASE_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2
SIMILARITY_MODEL_VERSION=
SIMILARITY_SCORING_WEIGHT=0.0
SIMILARITY_SCORE_THRESHOLD=0.0
SIMILARITY_FALLBACK_MODE=base_model

# Resume section-classifier (ML-assisted section_splitter.py) — off by
# default (SECTION_CLASSIFIER_FALLBACK_MODE=regex_only). See
# docs/section-classifier-v0.1.md.
SECTION_CLASSIFIER_MODEL_PATH=
SECTION_CLASSIFIER_FALLBACK_MODE=regex_only

# JD section-classifier (ML-assisted job_description_parser.py) — off by
# default (JD_SECTION_CLASSIFIER_FALLBACK_MODE=regex_only).
JD_SECTION_CLASSIFIER_MODEL_PATH=
JD_SECTION_CLASSIFIER_FALLBACK_MODE=regex_only

# PDF OCR fallback for scanned documents, and for PDFs whose embedded text
# extracts corrupted. English-only for now: multi-language ("en+vi")
# fallback has known issues (the language-priority check accepts an
# English OCR pass that silently drops Vietnamese diacritics because it
# has no corrupted glyphs to detect, and overlapping OCR regions produce
# duplicate lines) — out of scope until revisited.
# PDF_OCR_LANGUAGES tries each "+"-separated language in order, stopping
# at the first clean (non-corrupted) result.
ENABLE_PDF_OCR_FALLBACK=false
PDF_OCR_ENGINE=paddleocr
PDF_OCR_MODE=targeted
PDF_OCR_LANGUAGES=en
PDF_OCR_MAX_PAGES=2
PDF_OCR_MIN_CONFIDENCE=0.5