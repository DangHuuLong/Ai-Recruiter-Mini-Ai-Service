# Fine-tuned model weights are large — only the versions actually referenced by env vars
# (SIMILARITY_MODEL_PATH etc.) are tracked, via Git LFS, so CI can build the AI service
# image from a fresh checkout. Update these lines when the referenced version changes.
models/*
